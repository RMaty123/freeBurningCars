{
  "name": "free-burning-cars",
  "version": "0.2.0",
  "description": "Free Burning Cars – 3D akční závodní hra pro obývák. Obrazovka na PC, telefony jako ovladače.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"client/**\" server/index.ts",
    "dev:once": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "prod": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:sim": "tsx scripts/simtest.ts",
    "check:tracks": "tsx scripts/trackcheck.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.170.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
